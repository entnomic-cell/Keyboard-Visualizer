Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

# Win32 API functions
$signature = @"
using System;
using System.Runtime.InteropServices;

public class Win32 {
    [DllImport("user32.dll")]
    public static extern IntPtr GetForegroundWindow();

    [DllImport("user32.dll")]
    public static extern int GetWindowText(IntPtr hWnd, System.Text.StringBuilder text, int count);

    [DllImport("user32.dll")]
    public static extern int GetWindowTextLength(IntPtr hWnd);
}
"@

Add-Type -TypeDefinition $signature

function Get-ForegroundWindowTitle {
    $hwnd = [Win32]::GetForegroundWindow()
    if ($hwnd -eq [IntPtr]::Zero) { return "" }

    $length = [Win32]::GetWindowTextLength($hwnd)
    if ($length -le 0) { return "" }

    $builder = New-Object System.Text.StringBuilder ($length + 1)
    [Win32]::GetWindowText($hwnd, $builder, $builder.Capacity) | Out-Null
    return $builder.ToString()
}

# Create overlay form
$form = New-Object System.Windows.Forms.Form
$form.FormBorderStyle = 'None'
$form.StartPosition = 'Manual'
$form.Location = New-Object System.Drawing.Point(0, 0)
$form.Size = New-Object System.Drawing.Size(260, 120)
$form.TopMost = $true
$form.ShowInTaskbar = $false
$form.BackColor = [System.Drawing.Color]::Black
$form.TransparencyKey = [System.Drawing.Color]::Black

# Label (green text)
$label = New-Object System.Windows.Forms.Label
$label.ForeColor = [System.Drawing.Color]::Lime
$label.Font = New-Object System.Drawing.Font("Consolas", 9, [System.Drawing.FontStyle]::Bold)
$label.AutoSize = $true
$label.Location = New-Object System.Drawing.Point(8, 8)
$label.Text = "Waiting..."
$form.Controls.Add($label)

# Draw triangle
$form.Add_Paint({
    $g = $_.Graphics
    $p1 = New-Object System.Drawing.Point(0, 0)
    $p2 = New-Object System.Drawing.Point(260, 0)
    $p3 = New-Object System.Drawing.Point(0, 120)

    $points = New-Object System.Drawing.Point[] 3
    $points[0] = $p1
    $points[1] = $p2
    $points[2] = $p3

    $brush = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(160, 0, 0, 0))
    $g.FillPolygon($brush, [System.Drawing.Point[]]$points)
})

# Update label instantly when active window changes
$lastTitle = ""

$timer = New-Object System.Windows.Forms.Timer
$timer.Interval = 50  # fast update
$timer.Add_Tick({
    try {
        $title = Get-ForegroundWindowTitle
        if ($title -and $title -ne $lastTitle) {
            $lastTitle = $title
            $label.Text = $title
        }
    } catch {}
})

$timer.Start()
[void]$form.ShowDialog()
