#Requires -Version 5.1
# Combined Monitor Script - Drive Monitor + Window Title + Key/Mouse Hook
# Save as CombinedMonitor.ps1 and run with: powershell -ExecutionPolicy Bypass -File CombinedMonitor.ps1

Add-Type -AssemblyName PresentationFramework, PresentationCore, WindowsBase, System.Windows.Forms
Add-Type -AssemblyName System.Drawing

# --------------------- CONFIG ---------------------
$UseUnicodeArrows = $true
$Opacity          = 0.92
$FontSize         = 14
$KeyColor         = "Lime"
$MouseMoveColor   = "Cyan"
$MouseClickColor  = "Yellow"
$DriveColor       = "Orange"
$WindowColor      = "White"
$BgAlpha          = 200
$GripHeight       = 16
$PositionX        = [System.Windows.Forms.Screen]::PrimaryScreen.WorkingArea.Right - 320
$PositionY        = [System.Windows.Forms.Screen]::PrimaryScreen.WorkingArea.Bottom - 260
$DisplayTime      = 0.15
$PollIntervalMs   = 16
$DriveCheckMs     = 3000
# --------------------------------------------------

# Win32 API for foreground window
$signature = @"
using System;
using System.Runtime.InteropServices;
using System.Text;

public class Win32Monitor {
    [DllImport("user32.dll")]
    public static extern IntPtr GetForegroundWindow();

    [DllImport("user32.dll")]
    public static extern int GetWindowText(IntPtr hWnd, StringBuilder text, int count);

    [DllImport("user32.dll")]
    public static extern int GetWindowTextLength(IntPtr hWnd);

    [DllImport("user32.dll")]
    public static extern uint GetWindowThreadProcessId(IntPtr hWnd, out uint processId);
}
"@
Add-Type -TypeDefinition $signature -ErrorAction SilentlyContinue

function Get-ForegroundWindowTitle {
    $hwnd = [Win32Monitor]::GetForegroundWindow()
    if ($hwnd -eq [IntPtr]::Zero) { return "" }
    $length = [Win32Monitor]::GetWindowTextLength($hwnd)
    if ($length -le 0) { return "" }
    $builder = New-Object System.Text.StringBuilder ($length + 1)
    [Win32Monitor]::GetWindowText($hwnd, $builder, $builder.Capacity) | Out-Null
    return $builder.ToString()
}

# ─────────────────────────────────────────────────────────────
#   Main WPF Window
# ─────────────────────────────────────────────────────────────
